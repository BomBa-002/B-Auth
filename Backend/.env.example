NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-min-16-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SESSION=1d
JWT_REFRESH_TTL_REMEMBER=30d

COOKIE_DOMAIN=
COOKIE_SECURE=false

DATA_DIR=./data

# Optional — MinIO/S3-compatible object storage. Storage module runs in
# "degraded" mode (reports unhealthy, uploads disabled) if unset.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=b-auth-minio
S3_SECRET_ACCESS_KEY=b-auth-minio-secret
S3_BUCKET=b-auth-storage
S3_FORCE_PATH_STYLE=true

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_EMAIL=admin@b-auth.local

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
