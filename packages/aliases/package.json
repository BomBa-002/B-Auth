{
  "name": "@b-auth/aliases",
  "version": "1.0.0",
  "private": true,
  "description": "Single source-of-truth path-alias map for the B-Auth monorepo (consumed by tsconfig + vite.config).",
  "type": "module",
  "main": "./alias.config.mjs",
  "types": "./alias.config.mjs",
  "exports": {
    ".": {
      "import": "./alias.config.mjs",
      "default": "./alias.config.mjs"
    },
    "./alias.config": {
      "import": "./alias.config.mjs",
      "default": "./alias.config.mjs"
    },
    "./alias.config.mjs": "./alias.config.mjs"
  },
  "scripts": {
    "generate:ts-paths": "node scripts/generate-ts-paths.mjs"
  }
}
